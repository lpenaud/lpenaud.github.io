extends layout/main-layout.pug
block content
  div.columns.is-vcentered.is-centered
    div.column(aria-hidden=true)
    div.column.is-narrow
      figure.image.is-128x128
        img.is-rounded(src="https://bulma.io/assets/images/placeholders/128x128.png", alt="Une photo de moi souriant.")
    div.column
      p.title PENAUD Loïc
      p.subtitle Lead développeur et ops en devenir
    div.column(aria-hidden=true)
extends main-layout.pug

block navbar-brand
  p.title PENAUD Loïc

block navbar-start
  each item in navbarStartItems
    +navbar-item(item)

block navbar-end
  each item in navbarEndItems
    +navbar-item(item)

block hero-body
  div.columns.is-vcentered.is-centered.is-max
    div.column(aria-hidden=true)
    div.column.is-3
      figure.image
        img.is-rounded(src="https://bulma.io/assets/images/placeholders/256x256.png", alt="Une photo de moi souriant.")
    div.column(aria-hidden=true)
    div.column.is-7
      p.title.is-2 PENAUD Loïc
      p.subtitle.is-2 Programmeur en chef et ops en devenir
      +box.is-size-4
        | Programmeur qui accompagne les autres dévelopeurs depuis plus de 5 ans.
        | Auto-hébergeur de service de la toile depuis 6 ans.
    div.column(aria-hidden=true)

block content
  +section
    +columns-centered
      div.column.is-3
        p.title.is-2#about-me À propos de moi
    +columns-centered()
      div.column.is-4
        +box
          p.is-size-5.has-text-justified
            | Bonjour !
            br
            | Je m’appelle Loïc Penaud, finistérien de 27 ans.
            | Depuis le lycée (2014), je prototype mes propres programmes tout en partageant mon savoir avec les autres.
            | Grâce à mes années d’études j’ai pu approfondir cet art.
            | Pour finalement, en #[strong 2022], devenir un véritable ingénieur logiciel qui cumule aujourd’hui #[strong 5 ans d’expérience].
      +hidden-column().is-1
      div.column.is-4
        +box
          p.title.is-4 En bref
          +box
            p.title.is-size-6
              span.icon-text
                span.icon
                  :material-icon(style="outlined" name="work")
                span Emploie actuel
            p.is-size-6 Ingénieur logiciel chez Infotel depuis 2022.
          +box
            p.title.is-size-6
              span.icon-text
                span.icon
                  :material-icon(style="outlined" name="school")
                span Formation
            p.is-size-6
              strong Master mention informatique 
              | parcours #[strong TIIL-A] (Technologies de l’Information et Ingénierie du Logiciel par Alternance)
              | à l’#[strong UBO] (Université de Bretagne Occidentale).
          +box
            p.title.is-size-6
              span.icon-text
                span.icon
                  :material-icon(style="outlined" name="language")
                span Langues
            +tags("🇫🇷 Français (langue maternelle)", "🇬🇧 Anglais (B2)", "🇪🇸 Espagnol (A2)").are-medium
          +box
            p.title.is-size-6
              span.icon-text
                span.icon
                  :material-icon(style="outlined" name="spa")
                span Centres d’intérêt
            +tags(
              "🛶 Kayak de mer",
              "🎮 Jeux-vidéo",
              "🎲 Jeux de rôle",
              "🚴‍♂️ Cyclisme",
              "🥘 Cuisine",
              "🎶 Musique / Concert",
              "📽️ Cinéma",
              "📺 Série",
              "🎨 Musée",
              "🧳 Voyage").are-medium
  +section
    +columns-centered
      div.column.is-3
        p.title.is-2#skills Compétences
  +section
    +columns-centered
      div.column.is-3
        p.title.is-2#experience Expérience
  +section
    +columns-centered
      div.column.is-3
        p.title.is-2#tools Outils et cadriciels
  +section
    +columns-centered
      div.column.is-3
        p.title.is-2#contact Contact

block footer
  p Développé avec #[strong passion] avec :
  ul
    li
      +ab("https://deno.com/", "Deno") 
      | et sa bibliothéque standard (
      +ab("https://jsr.io/@std", "std")
      | )
    li 
      +ab("https://pugjs.org", "Pugjs")
    li
      +ab("https://bulma.io", "Bulma")
      |  et 
      +ab("https://sass-lang.com/", "Sass")
    li 
      +ab("https://marella.github.io/material-design-icons/demo/svg/", "material-design-icons")


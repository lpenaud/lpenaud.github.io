extends experience-card.pug

block variables
  -
    title = "Ingénieur logiciel"
    company = "Infotel (Brest)"
    startDate = new Date(2020, 5, 15)
    tags = [
      "Java",
      "Spring",
      "API REST",
      "TypeScript",
      "JavaScript",
      "Bash",
      "Deno",
      "Node",
      "Postman",
      "Git",
      "Vue 3",
    ]

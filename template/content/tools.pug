+section-title("Outils et cadriciels")

//- { sources: [{ media: string; src: string }] }

mixin tool-figure(alt, src="https://bulma.io/assets/images/placeholders/96x96.png", ...sources)
  figure.image.is-64x64.my-auto.mx-auto
    picture
      each s in sources
        source(srcset=s.src, media=s.media)
      img(src=src, alt=alt)
  p.is-italic= alt

mixin tool-box(toolbox)
  div.column.is-4.has-text-centered
    div.box.is-fullheight
      div.columns.is-fullheight
        div.column
          +h4(toolbox.title)
          div.columns.is-centered.is-multiline.is-mobile.is-vcentered.is-fullheight
            each tool in toolbox.tools
              div.column
                +tool-figure(tool.alt, tool.src, ...tool.sources)

div.container
  div.columns.is-multiline
    each t in toolboxes
      +tool-box(t)

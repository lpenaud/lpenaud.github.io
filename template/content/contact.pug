+section-title("Contact")
+box    
  div.fixed-grid.has-2-cols
    div.grid.is-align-items-center
      div.cell.is-col-span-2
        div.p.is-size-5.has-text-centered
          | Vous souhaitez me contacter ?
          | Je suis ouvert aux échanges techniques et aux propositions de missions.
      //- Contact form
      div.cell.has-text-right
        :icon-text(name="forum" size="large")
      div.cell.has-text-left.is-vcentered
        a(href="https://acloud8.zaclys.com/index.php/apps/forms/s/ks594pWkE2jRB6gq3ZHMLgwW", target="_blank", rel="noopener noreferrer").is-size-5 Formulaire de contact
      //- Email
      div.cell.has-text-right
        :icon-text(name="email" size="large")
      div.cell.has-text-left.is-vcentered
        a(href="mailto:l.penaud@zaclys.net").is-size-5 Courriel
      //- Github
      div.cell.has-text-right
        :icon-text(name="github" size="large")
      div.cell.has-text-left.is-vcentered
        a(href="https://github.com/lpenaud", target="_blank", rel="noopener noreferrer").is-size-5 Github
      //- Linkedin
      div.cell.has-text-right
        :icon-text(name="linkedin" size="large")
      div.cell.has-text-left.is-vcentered
        a(href="https://www.linkedin.com/in/lo%C3%AFc-penaud-296067129/", target="_blank", rel="noopener noreferrer").is-size-5 Linkedin

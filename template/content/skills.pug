mixin skills-column()
  div.cell.is-row-1&attributes(attributes)
    +box
      div.content
        block

+section-title("Compétences")
div.fixed-grid.has-1-cols-mobile.has-2-cols-tablet.has-3-cols-widescreen.ml-auto.mr-auto
  div.grid
    +skills-column
      +h4
        :icon-text(name="web")
          Frontale
      ul
        li Maquettage de site interatif
        li Création de kit de développement (SDK) pour appeler des services de la toile
        li Organisation de composants réutilisable
    +skills-column
      +h4
        :icon-text(name="server-outline")
          Dorsale
      ul
        li Conception d'interface de programmation applicative (API)
        li Développement de service asynchrone
        li Interaction directionnel ou bidirectionnel
    +skills-column
      +h4
        :icon-text(name="shape-outline")
          Conteneur
      ul
        li Création de conteneur
        li Utilisation de sous-réseaux
        li Orchestration de conteneur
    +skills-column
      +h4
        :icon-text(name="source-branch-sync")
          Intégration continue (CI)
      ul
        li Conception de pipeline automatisée.
        li Création des différentes étapes de contructions d'application
    +skills-column
      +h4
        :icon-text(name="console")
          Script
      ul
        li Création de script d'automatisation
        li Élaboration d'application en ligne de commande (CLI)
    +skills-column
      +h4
        :icon-text(name="account-supervisor-outline")
          Formateur
      ul
        li Création de formation
        li Relecture de code
        li Binômage